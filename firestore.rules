rules_version = '2';
// Publicar en Firebase Console → Firestore Database → Reglas.
// Estas reglas NO borran ni modifican datos: solo controlan quién puede leer/escribir.
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(owner) { return request.auth != null && request.auth.uid == owner; }
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'rgaraventa@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function esCajero(owner) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && exists(/databases/$(database)/documents/negocios/$(owner)/cajeros/$(request.auth.uid));
    }

    // Registro de usuarios (para el panel de actividad): cada dueño escribe solo el suyo; el admin lee todos.
    match /usuarios/{uid} {
      allow read: if esAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['email','nombre','alta','ultimoAcceso','app']);
      allow delete: if esAdmin();
    }

    // Membresía de cajero: se crea sólo si el PIN coincide con el que fijó el dueño.
    match /negocios/{owner}/cajeros/{cid} {
      allow read: if esDueno(owner) || esAdmin() || (request.auth != null && request.auth.uid == cid);
      allow create: if request.auth != null
        && request.auth.uid == cid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.pin == get(/databases/$(database)/documents/negocios/$(owner)/configuracion/general).data.pinCajero;
      allow delete: if esDueno(owner);
    }

    // Datos del negocio: el dueño todo; el cajero (con membresía) opera caja; el admin solo lee (copias de seguridad).
    match /negocios/{owner}/{col}/{doc=**} {
      allow read, write: if esDueno(owner)
        || (col in ['ventas','productos','insumos','gastos','cierres','comandas'] && esCajero(owner));
      allow read: if esAdmin();
      allow read: if col == 'configuracion' && esCajero(owner);
    }

    // Registro de errores: cualquiera escribe, solo el admin lee
    match /errores/{id} {
      allow create: if request.auth != null;
      allow read: if esAdmin();
    }

    // Datos anteriores en la raíz: cerrados
    match /{path=**} { allow read, write: if false; }
  }
}
